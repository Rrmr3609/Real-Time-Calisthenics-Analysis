# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
*.swp
*.swo

# Windows and macOS files
Thumbs.db
desktop.ini
.DS_Store

# Raw and processed recordings
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Generated experiment files
experiments/logs/*
!experiments/logs/.gitkeep

experiments/outputs/*
!experiments/outputs/.gitkeep

# Large video files
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Generated model files
*.tflite
*.onnx
*.pt
*.pth

# Temporary output
*.tmp
*.log

# Local pytest temporary directory
.pytest_tmp/
